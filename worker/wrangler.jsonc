{
  // Deploy:  cd worker && npx wrangler d1 create medbook && (paste the database_id below)
  //          npx wrangler secret put ANTHROPIC_API_KEY ; npx wrangler secret put APP_TOKEN
  //          npx wrangler deploy
  "name": "medbook-rag",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "../web", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "medbook", "database_id": "5a4086a4-3194-4671-a34e-3034c2d77226" }],
  // Optional: page images for "view the original page" (create with `wrangler r2 bucket create medbook-pages`)
  // "r2_buckets": [{ "binding": "PAGES", "bucket_name": "medbook-pages" }],
  "vars": {
    "MODEL": "claude-sonnet-5-5",
    "ALLOWED_MODELS": "claude-sonnet-5-5,claude-opus-5-5",
    // /api/ask calls per day (Japan time). Provisional value; "0" turns the cap off. Counts live in D1 table usage_daily.
    "DAILY_ASK_LIMIT": "100",
    // conversations (saved in D1) are deleted this many days after their last turn; "0" keeps them until deleted. Provisional value
    "CONVERSATION_RETENTION_DAYS": "30",
    // case records (saved in D1) are deleted this many days after their last update; "0" keeps them until the doctor ends the case. Provisional value
    "CASE_RECORD_RETENTION_DAYS": "60"
    // "WEB_ALLOWED_DOMAINS": "kdigo.org,jsn.or.jp,..."   // defaults live in src/prompt.ts
  }
}
